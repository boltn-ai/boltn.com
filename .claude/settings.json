{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Bash(git commit --no-verify:*)",
			"Bash(git commit -n:*)",
			"Bash(git push --no-verify:*)",
			"Bash(LEFTHOOK=0:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git push --force-with-lease:*)",
			"Bash(git push origin main:*)",
			"Bash(git push origin HEAD:main:*)",
			"Bash(gh pr merge:*)",
			"Bash(vercel --prod:*)",
			"Bash(vercel deploy --prod:*)",
			"Bash(vercel promote:*)"
		],
		"ask": [
			"Edit(harness/**)",
			"Edit(.github/**)",
			"Edit(.claude/settings.json)",
			"Edit(lefthook.yml)",
			"Edit(biome.json)",
			"Edit(knip.jsonc)",
			"Edit(tsconfig.json)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/harness/agent/after-edit.mjs\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/harness/agent/before-stop.mjs\"",
						"timeout": 120
					}
				]
			}
		]
	}
}
