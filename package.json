{
	"name": "boltn-site",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "velite dev & next dev --turbopack",
		"build": "velite build && next build",
		"start": "next start",
		"prepare": "lefthook install",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "velite build && tsc --noEmit",
		"test": "node --test --test-reporter=dot \"app/assessment/_lib/*.test.ts\"",
		"knip": "knip --no-progress",
		"check:design": "node harness/check-design-rules.mjs",
		"check:private": "node harness/check-private-terms.mjs",
		"check:secrets": "gitleaks git --no-banner --redact .",
		"check:budgets": "node harness/check-budgets.mjs",
		"check:quick": "pnpm lint && pnpm check:design && pnpm check:private && pnpm typecheck && pnpm test",
		"check": "pnpm check:quick && pnpm check:secrets && pnpm knip && pnpm build && pnpm check:budgets"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"clsx": "^2.1.1",
		"feed": "^5.2.0",
		"lucide-react": "^0.577.0",
		"next": "16.1.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-pretty-code": "^0.14.3",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"resend": "^6.9.3",
		"shiki": "^4.0.2",
		"tailwind-merge": "^3.5.0",
		"velite": "^0.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"knip": "^6.45.1",
		"lefthook": "^2.2.2",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "pnpm@8.15.1+sha1.8adba2d20330c02d3856e18c4eb3819d1d3ca6aa"
}
